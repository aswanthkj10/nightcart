# Set these in Render Dashboard → your service → Environment.
# Never commit real credentials. Render supplies PORT automatically.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/nightcart?retryWrites=true&w=majority
REDIS_HOST=YOUR-REDIS-HOST
REDIS_PORT=YOUR-REDIS-PORT
REDIS_USERNAME=default
REDIS_PASSWORD=YOUR-REDIS-PASSWORD
REDIS_SSL=true
NEO4J_URI=neo4j+s://YOUR-AURA-ID.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=YOUR-AURA-PASSWORD
# Keep false until a reachable MonetDB server is configured.
MONETDB_ENABLED=false
MONETDB_URL=jdbc:monetdb://YOUR-MONETDB-HOST:50000/demo
MONETDB_USERNAME=monetdb
MONETDB_PASSWORD=YOUR-MONETDB-PASSWORD
